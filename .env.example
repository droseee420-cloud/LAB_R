# Copy to .env for manual setup; `pnpm stack:up` creates it with random secrets when absent.
COMPOSE_PROJECT_NAME=refraction
PUBLIC_URL=http://localhost:8080
HTTP_TEST_MODE=true
HTTP_PORT=8080
BIND_ADDRESS=127.0.0.1
POSTGRES_DB=lab
POSTGRES_USER=lab
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
COOKIE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
COOKIE_DAYS=365
RATE_LIMIT=10
RATE_WINDOW=600
PROXY_RATE=6r/m
PROXY_BURST=6
APP_SUBNET=172.30.80.0/24
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_ORIGIN=
ADMIN_HOST=admin.invalid
ADMIN_BASE_PATH=/admin
ADMIN_SESSION_HOURS=12
ADMIN_LOGIN_LIMIT=6
ADMIN_PROXY_RATE=6r/m
ADMIN_PROXY_BURST=6
