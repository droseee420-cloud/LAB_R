worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr crit;
events { worker_connections 512; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    map $host $site_upstream { default http://frontend:3000; ${ADMIN_HOST} http://admin:3000; }
    access_log off;
    server_tokens off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    client_max_body_size 31m;
    client_body_timeout 30s;
    client_header_timeout 15s;
    keepalive_timeout 30s;
    limit_req_zone $binary_remote_addr zone=brief:10m rate=${PROXY_RATE};
    limit_req_zone $binary_remote_addr zone=admin_login:1m rate=${ADMIN_PROXY_RATE};
    limit_req_zone $binary_remote_addr zone=prepare:1m rate=10r/s;
    limit_conn_zone $binary_remote_addr zone=connections:1m;
    resolver 127.0.0.11 valid=10s ipv6=off;
    server {
        listen 8443 ssl;
        ssl_certificate /certificates/fullchain.pem;
        ssl_certificate_key /certificates/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        add_header Strict-Transport-Security max-age=31536000 always;
        server_name _;
        if ($host ~* ^www\.(.+)$) { return 301 https://$1$request_uri; }
        limit_conn connections 10;
        limit_conn_status 429;
        limit_req_status 429;
        error_page 429 = @limited;
        error_page 413 = @large;
        location @limited {
            default_type application/json;
            add_header Retry-After 60 always;
            return 429 '{"ok":false,"code":"rate_limited","error":"Too many attempts. Please try again later."}';
        }
        location @large {
            default_type application/json;
            return 413 '{"ok":false,"code":"file_size","error":"Request exceeds 31 MiB."}';
        }
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_http_version 1.1;
        proxy_read_timeout 100s;
        proxy_send_timeout 100s;
        add_header X-Content-Type-Options nosniff always;
        location = /api/brief {
            limit_req zone=brief burst=${PROXY_BURST} nodelay;
            set $api http://api:8000;
            proxy_pass $api;
        }
        location = /api/admin/login {
            client_max_body_size 64k;
            limit_req zone=admin_login burst=${ADMIN_PROXY_BURST} nodelay;
            set $api http://api:8000;
            proxy_pass $api;
        }
        location /api/admin/ {
            client_max_body_size 64k;
            set $api http://api:8000;
            proxy_pass $api;
        }
        location ~ ^/admin(?:/|$) {
            proxy_hide_header Cache-Control;
            proxy_hide_header X-Frame-Options;
            proxy_hide_header Referrer-Policy;
            add_header Cache-Control "no-store, private" always;
            add_header X-Content-Type-Options nosniff always;
            add_header X-Frame-Options DENY always;
            add_header Referrer-Policy no-referrer always;
            set $admin http://admin:3000;
            proxy_pass $admin;
        }
        location /api/ {
            limit_req zone=prepare burst=20 nodelay;
            set $api http://api:8000;
            proxy_pass $api;
        }
        location / {
            set $frontend $site_upstream;
            proxy_pass $frontend;
        }
    }
    server {
        listen 8080;
        server_name _;
        if ($host ~* ^www\.(.+)$) { return 301 https://$1$request_uri; }
        location = /api/health {
            set $api http://api:8000;
            proxy_pass $api;
        }
        location / { return 301 https://$host$request_uri; }
    }}
