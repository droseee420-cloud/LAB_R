{
  "name": "refraction-lab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm stack:up",
    "stack:up": "node scripts/workspace.mjs stack up --build -d --wait --wait-timeout 180",
    "stack:down": "node scripts/workspace.mjs stack down",
    "stack": "node scripts/workspace.mjs stack",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy/deploy.ps1",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:quick": "node scripts/workspace.mjs quick",
    "test:full": "node scripts/workspace.mjs full"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2"
  }
}
